[Unit]
Description=人口通 - 服务端
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=__INSTALL_DIR__
Environment="PATH=__INSTALL_DIR__/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_ENV=production"
Environment="PYTHONUNBUFFERED=1"
Environment="TZ=Asia/Shanghai"

# gunicorn 直接终结 TLS（不再经 stunnel 转发）：
# 这样 request.remote_addr 就是真实客户端 IP，操作日志才能记到来源地址。
ExecStart=__INSTALL_DIR__/venv/bin/gunicorn \
    --workers __WORKERS__ \
    --threads 4 \
    --bind [::]:__PORT__ \
    --certfile __CERT_DIR__/server.crt \
    --keyfile __CERT_DIR__/server.key \
    --ca-certs __CA_CERT__ \
    --cert-reqs 2 \
    --timeout 120 \
    --max-requests 1000 \
    --max-requests-jitter 50 \
    --access-logfile __INSTALL_DIR__/logs/access.log \
    --error-logfile __INSTALL_DIR__/logs/error.log \
    --log-level info \
    app_modular:app

Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
KillMode=process

[Install]
WantedBy=multi-user.target
