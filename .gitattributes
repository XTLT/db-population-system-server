# 统一行尾：所有会被部署到 Linux 的文本文件强制 LF（避免 CRLF 导致 bash/systemd/stunnel 解析错误）
*.sh    text eol=lf
*.py    text eol=lf
*.service text eol=lf
*.conf  text eol=lf
*.ini   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.example text eol=lf
Dockerfile text eol=lf
